### Add test IDs to a POC
PUT http://localhost:4000/poc_gateway/poc/update_test
Content-Type: application/json

{
    "mod_poc_id": "9ccefe74-f80c-4427-804e-827a61d7619a",
    "test_id": [
        { "test_id": "b2b727d1-f034-4636-9a28-b6cd84d07043", "assigned_date": "10/04/2025" },
        { "test_id": "7213c219-3295-462d-b6cf-e35e3ee03a75", "assigned_date": "09/04/2025" }
    ]
}

### Delete all test_ids from a POC
DELETE http://localhost:4000/poc_gateway/poc/delete_test/57b7bb55-a49e-4065-b38d-fbd13c396d2b

### Delete a POC
DELETE http://localhost:4000/poc_gateway/poc/delete_poc/8ddcfe54-c282-4ce1-80d2-21cab5ec7819

### Get mod_id by user_id
GET http://localhost:4000/poc_gateway/poc/mod_by_user/717150b2-2a19-45e8-9c24-69d93b4751c2

### Get mod_id, mod_poc_id, mod_poc_name, and tests by user_id
GET http://localhost:4000/poc_gateway/poc/mod_and_poc/717150b2-2a19-45e8-9c24-69d93b4751c2

### Get today's test IDs from a specific POC
GET http://localhost:4000/poc_gateway/poc/tests_today/9ccefe74-f80c-4427-804e-827a61d7619a

### Get test IDs from a POC up to today's date
GET http://localhost:4000/poc_gateway/poc/tests_till_today/9ccefe74-f80c-4427-804e-827a61d7619a

### Get all tests with POC ID
GET http://localhost:4000/poc_gateway/poc/get_all_tests/9ccefe74-f80c-4427-804e-827a61d7619a

### Get POC certificate by mod_id
GET http://localhost:4000/poc_gateway/poc/get_poc_certificate_by_mod_id/6503caf1-fb75-4640-99f2-d6a529b71205