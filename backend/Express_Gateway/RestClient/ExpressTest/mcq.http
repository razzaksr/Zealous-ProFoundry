POST http://localhost:4000/mcq_gateway/mcq/add_mcq
Content-Type: application/json

[
    {
        "mcq_question": "What is Express.js?",
        "mcq_options": ["Framework", "Library", "Runtime", "Database"],
        "mcq_answer": "Framework",
        "mcq_tag": ["Backend", "Node.js"]
    },
