### Create a Coding data
POST http://localhost:8000/coding/code
Content-Type: application/json

{
  "code_problem_statement": "Write a function to check if a number is prime.",
  "code_test_cases_id": ["test1", "test2"],
  "code_tags": ["maths", "prime numbers", "loops"]
}

### Get All Codes
GET http://localhost:8000/coding/get_allCodes

### Get code details by id 
GET http://localhost:8000/coding/get_code_by_id/9ee19f23-e30b-434d-a541-af9e5c51eac3


### Update the Code
PUT http://localhost:8000/coding/update_code
Content-Type: application/json

{
  "code_id": "2021bea1-2ab1-4d70-b997-623ca8935ffb",
  "code_problem_statement": "Write a function to find the factorial of a number.",
  "code_test_cases": ["test1", "test2"],
  "code_tags": ["math", "recursion", "factorial"]
}

### Delete a code
DELETE http://localhost:8000/coding/delete_code/2021bea1-2ab1-4d70-b997-623ca8935ffb

###############
POST http://localhost:8000/coding/compiler
Content-Type: application/json

{
  "language": "java",
  "code": "import java.util.Scanner;\n\npublic class Factorial {\n    public static int factorial(int n) {\n        if (n == 0 || n == 1)\n            return 1;\n        return n * factorial(n - 1);\n    }\n\n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        int input = sc.nextInt();\n        System.out.println(factorial(input));\n        sc.close();\n    }\n}",
  "testCases": [
    { "input": "5", "expectedOutput": "120" },
    { "input": "6", "expectedOutput": "720" },
    { "input": "7", "expectedOutput": "5040" }
  ]
}
