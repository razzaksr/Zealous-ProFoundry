### Create User
POST http://localhost:7000/user/add_user
Content-Type: application/json

{
  "full_name": "John Doe",
  "department": "Computer Science",
  "college": "XYZ University",
  "rollno": "CS2025001",
  "email": "johndoe@example.com",
  "password": "securepassword",
  "status": "active",
  "user_last_login": "2025-03-16T10:00:00Z"
}

### Get All Users
GET http://localhost:7000/user/read_all_users

### Get User by ID
POST http://localhost:7000/user/get_user_by_id
Content-Type: application/json

{
  "user_id": "a184c2d5-a52d-4f03-8bbb-0f1d8221bc13"
}

### Update User
PUT http://localhost:7000/user/update_user
Content-Type: application/json

{
  "user_id": "a184c2d5-a52d-4f03-8bbb-0f1d8221bc13",
  "full_name": "Updated John Doe",
  "email": "updated@example.com",
  "password": "newpassword123"
}

### Update User Last Login
PUT http://localhost:7000/user/update_last_login
Content-Type: application/json

{
  "user_id": "a184c2d5-a52d-4f03-8bbb-0f1d8221bc13",
  "user_last_login": "2025-03-16T12:30:00Z"
}

### Delete User
DELETE http://localhost:7000/user/delete_user
Content-Type: application/json

{
  "user_id": "a184c2d5-a52d-4f03-8bbb-0f1d8221bc13"
}